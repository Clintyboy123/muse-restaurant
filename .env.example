# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds real passwords and must never be committed or shared.
# Generate each password/secret with:      openssl rand -base64 32

# --- Application -------------------------------------------------------------
NODE_ENV=production
APP_NAME="Muse Restaurant"

# Unique per website. Names this site's containers, network and database volume.
# Lowercase letters, numbers, dashes and underscores only, e.g. the domain without dots.
COMPOSE_PROJECT_NAME=muserestaurant

# --- Ports -------------------------------------------------------------------
# The port the VPS-level Nginx forwards this domain to. Must be unique per website on the VPS.
FRONTEND_PORT=8104

# Internal only (never public). If you change it, change it in frontend/nginx/default.conf too.
BACKEND_PORT=3000

# How many proxies sit in front of the API: 2 on the VPS (VPS Nginx + frontend Nginx).
TRUST_PROXY=2

# --- Database ----------------------------------------------------------------
MYSQL_DATABASE=muse
MYSQL_USER=muse
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# The database's Docker service name and port. Leave as they are.
DB_HOST=database
DB_PORT=3306

# --- Project-specific -----------------------------------------------------------
# Form emails. Every reservation enquiry, event enquiry and message is saved in the database. If SMTP is set,
# it is also emailed to MAIL_TO, and guests get an acknowledgement. Leave SMTP_HOST empty to only save them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Muse Restaurant <no-reply@muserestaurant.co.za>"
MAIL_TO=info@muserestaurant.co.za
RESTAURANT_PHONE="+27 (0)41 582 1937"

# Google rating on the site. With an API key (Google Cloud > Places API (New)), the live rating and review
# count are read from Google every REVIEWS_CACHE_HOURS. Without a key, REVIEWS_RATING and REVIEWS_COUNT are
# shown: update them here when the Google numbers change (then restart the backend).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJx2vwI1nSeh4RIAKtMlOtSYY
REVIEWS_CACHE_HOURS=12
REVIEWS_RATING=4.8
REVIEWS_COUNT=920

# --- Deployment (set on the VPS by deploy/deploy.sh; leave unset on your computer) ---
# The exact images to run, e.g. ghcr.io/<owner>/<repo>-frontend:sha-<commit>. Unset = build locally.
# FRONTEND_IMAGE=
# BACKEND_IMAGE=
